            "required": false,
            "secret": false,
            "note": "Free public test facilitator: verifies + settles devnet payments and pays the SOL fees."
          },
          {
            "key": "AGENT_PRIVATE_KEY",
            "example": "",
            "required": false,
            "secret": true,
            "note": "DEVNET-ONLY throwaway key for the paying side (buyer). Base58 or solana-keygen JSON array. Never commit."
          },
          {
            "key": "SOLANA_RPC_URL",
            "example": "https://api.devnet.solana.com",
            "required": false,
            "secret": false,
            "note": "Optional devnet RPC used when building payments."
          }
        ],
        "prerequisites": [
          "A Solana devnet address to receive test payments (PAY_TO_ADDRESS); `npm run keygen -- --pay-to` makes one",
          "To pay: a throwaway devnet keypair (`npm run keygen`) funded with devnet USDC from https://faucet.circle.com (no real money)",
          "The receiving address also needs a devnet USDC token account: send it faucet USDC once"
        ],
        "readme": "README.fragment.md"
      },
