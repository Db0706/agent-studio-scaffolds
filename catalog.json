          },
          {
            "key": "X402_NETWORK",
            "example": "solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1",
            "required": false,
            "secret": false,
            "note": "CAIP-2 id. Only Solana devnet is allowed by this template."
          },
          {
            "key": "X402_FACILITATOR_URL",
