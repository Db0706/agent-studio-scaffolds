[
  {
    "framework": "next",
    "base": {
      "id": "base",
      "kind": "base",
      "framework": "next",
      "name": "Next.js web application",
      "description": "Next.js App Router + TypeScript starter. Every module is layered on top of this.",
      "requires": [],
      "files": [
        "app/layout.tsx",
        "app/page.tsx",
        "app/globals.css",
        "lib/modules.ts",
        "next.config.ts",
        "tsconfig.json",
        "package.json",
        ".gitignore",
        ".env.example",
        "README.md"
      ],
      "modulesFile": "lib/modules.ts",
      "generatedFiles": [
        "lib/modules.ts",
        "package.json",
        ".env.example",
        "README.md",
        "studio.manifest.json"
      ],
      "dependencies": {
        "next": "16.3.8",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "server-only": "0.0.1"
      },
      "devDependencies": {
        "typescript": "5.9.3",
        "@types/node": "22.20.5",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0"
      },
      "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "typecheck": "tsc --noEmit"
      },
      "env": [],
      "prerequisites": [
        "Node.js 20.9 or newer (22 LTS recommended)"
      ],
      "readme": "README.fragment.md"
    },
    "modules": [
      {
        "id": "gemini",
        "kind": "module",
        "framework": "next",
        "name": "Gemini AI",
        "summary": "Ask Google Gemini a question from a server route. Your key never reaches the browser.",
        "nav": {
          "label": "Gemini chat",
          "href": "/chat"
        },
        "requires": [],
        "files": [
          "lib/ai/gemini.ts",
          "app/api/chat/route.ts",
          "app/chat/page.tsx"
        ],
        "dependencies": {
          "@google/genai": "2.28.0"
        },
        "devDependencies": {},
        "scripts": {},
        "env": [
          {
            "key": "GEMINI_API_KEY",
            "example": "",
            "required": true,
            "secret": true,
            "note": "From https://aistudio.google.com/apikey. Server-only."
          },
          {
            "key": "GEMINI_MODEL",
            "example": "gemini-flash-latest",
            "required": false,
            "secret": false,
            "note": "Optional model override."
          }
        ],
        "prerequisites": [
          "Google account",
          "Gemini API key from Google AI Studio (free tier is enough)"
        ],
        "readme": "README.fragment.md"
      },
      {
        "id": "paidapi",
        "kind": "module",
        "framework": "next",
        "name": "Paid API Example",
        "summary": "A pay-per-request API route plus a buyer (page + CLI script) that pays for it within its spending limits.",
        "nav": {
          "label": "Paid API",
          "href": "/premium"
        },
        "requires": [
          "payments",
          "spending"
        ],
        "files": [
          "app/api/premium/route.ts",
          "app/api/buy/route.ts",
          "app/premium/page.tsx",
          "lib/paidapi/buyer.ts",
          "scripts/pay.ts"
        ],
        "dependencies": {},
        "devDependencies": {
          "tsx": "4.23.15"
        },
        "scripts": {
          "pay": "tsx --conditions=react-server scripts/pay.ts"
        },
        "env": [
          {
            "key": "PAID_API_PRICE_USD",
            "example": "0.01",
            "required": false,
            "secret": false,
            "note": "Price per request in (devnet) USDC. Default 0.01."
          }
        ],
        "prerequisites": [],
        "readme": "README.fragment.md"
      },
      {
        "id": "payments",
        "kind": "module",
        "framework": "next",
        "name": "Internet-Native Payments (x402 V2, Solana devnet)",
        "summary": "Charge for API routes with x402 V2 and pay for them with a devnet wallet. Test money only.",
        "requires": [],
        "files": [
          "lib/payments/config.ts",
          "lib/payments/server.ts",
          "lib/payments/client.ts",
          "scripts/keygen.ts",
          "scripts/wallets.ts"
        ],
        "dependencies": {
          "@x402/core": "2.28.0",
          "@x402/next": "2.28.0",
          "@x402/fetch": "2.28.0",
          "@x402/svm": "2.28.0",
          "@solana/kit": "5.5.1"
        },
        "devDependencies": {
          "tsx": "4.23.15"
        },
        "scripts": {
          "keygen": "tsx scripts/keygen.ts",
          "wallets": "tsx scripts/wallets.ts"
        },
        "env": [
          {
            "key": "PAY_TO_ADDRESS",
            "example": "",
            "required": true,
            "secret": false,
            "note": "Your Solana devnet wallet address. Payments to your paid API arrive here."
          },
          {
            "key": "X402_NETWORK",
            "example": "solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1",
            "required": false,
            "secret": false,
            "note": "CAIP-2 id. Only Solana devnet is allowed by this template."
          },
          {
            "key": "X402_FACILITATOR_URL",
            "example": "https://x402.org/facilitator",
            "required": false,
            "secret": false,
            "note": "Free public test facilitator: verifies + settles devnet payments and pays the SOL fees."
          },
          {
            "key": "AGENT_PRIVATE_KEY",
            "example": "",
            "required": false,
            "secret": true,
            "note": "DEVNET-ONLY throwaway key for the paying side (buyer). Base58 or solana-keygen JSON array. Never commit."
          },
          {
            "key": "SOLANA_RPC_URL",
            "example": "https://api.devnet.solana.com",
            "required": false,
            "secret": false,
            "note": "Optional devnet RPC used when building payments."
          }
        ],
        "prerequisites": [
          "A Solana devnet address to receive test payments (PAY_TO_ADDRESS); `npm run keygen -- --pay-to` makes one",
          "To pay: a throwaway devnet keypair (`npm run keygen`) funded with devnet USDC from https://faucet.circle.com (no real money)",
          "The receiving address also needs a devnet USDC token account: send it faucet USDC once"
        ],
        "readme": "README.fragment.md"
      },
      {
        "id": "spending",
        "kind": "module",
        "framework": "next",
        "name": "Spending Controls",
        "summary": "A total budget and a per-payment cap, checked before every automatic payment.",
        "requires": [
          "payments"
        ],
        "files": [
          "lib/spending/policy.ts",
          "lib/spending/tracker.ts",
          "lib/spending/attach.ts",
          "scripts/test-spending.ts",
          "scripts/test-spending-x402.ts"
        ],
        "dependencies": {},
        "devDependencies": {
          "tsx": "4.23.15"
        },
        "scripts": {
          "test:spending": "tsx --test scripts/test-spending.ts scripts/test-spending-x402.ts"
        },
        "env": [
          {
            "key": "AGENT_BUDGET_USD",
            "example": "1.00",
            "required": false,
            "secret": false,
            "note": "Total the buyer may spend before the server restarts. Default 1.00."
          },
          {
            "key": "MAX_PAYMENT_USD",
            "example": "0.10",
            "required": false,
            "secret": false,
            "note": "Largest single payment allowed. Default 0.10."
          }
        ],
        "prerequisites": [],
        "readme": "README.fragment.md"
      }
    ]
  },
